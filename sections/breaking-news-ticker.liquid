{%- liquid
  assign bnt_on = true
  if section.settings.enabled == false
    assign bnt_on = false
  endif

  assign bnt_max = section.settings.max_items | default: 4
  assign bnt_hours = section.settings.badge_hours | default: 48
  if bnt_max < 3
    assign bnt_max = 3
  endif
  if bnt_max > 5
    assign bnt_max = 5
  endif
  if bnt_hours < 24
    assign bnt_hours = 24
  endif
  if bnt_hours > 48
    assign bnt_hours = 48
  endif

  assign bnt_window = bnt_hours | times: 3600
  assign bnt_now = 'now' | date: '%s' | plus: 0
  assign bnt_blog = section.settings.blog
  if bnt_blog.articles == blank
    assign bnt_blog = blogs[section.settings.blog]
  endif
  if bnt_blog.articles == blank
    assign bnt_blog = blogs.news
  endif

  assign bnt_recent = false
  assign bnt_count = 0

  if bnt_on and bnt_blog != blank
    for article in bnt_blog.articles limit: 50
      assign bnt_match = false
      for tag in article.tags
        assign bnt_tag = tag | downcase | strip
        if bnt_tag == 'breaking'
          assign bnt_match = true
          break
        endif
      endfor
      if bnt_match
        if article.published_at != blank
          assign bnt_pub = article.published_at | date: '%s' | plus: 0
          assign bnt_age = bnt_now | minus: bnt_pub
          if bnt_count == 0 and bnt_age <= bnt_window
            assign bnt_recent = true
          endif
        endif
        unless bnt_recent
          break
        endunless
        assign bnt_count = bnt_count | plus: 1
        if bnt_count >= bnt_max
          break
        endif
      endif
    endfor
  endif

  assign bnt_copies = 2
  if bnt_count < 2
    assign bnt_copies = 1
  endif
-%}

{%- if bnt_on and bnt_recent -%}
  <section
    class="bnt{% if bnt_copies == 1 %} bnt--static{% endif %}"
    aria-label="{{ 'breaking_news.region_label' | t }}"
  >
    <div class="bnt__viewport">
      <div class="bnt__track">
        {%- for bnt_copy in (1..bnt_copies) -%}
          <ul
            class="bnt__list{% if bnt_copy == 2 %} bnt__list--clone{% endif %}"
            {% if bnt_copy == 2 %}
              aria-hidden="true" inert
            {% endif %}
          >
            {%- assign bnt_shown = 0 -%}
            {%- for article in bnt_blog.articles limit: 50 -%}
              {%- liquid
                assign bnt_match = false
                for tag in article.tags
                  assign bnt_tag = tag | downcase | strip
                  if bnt_tag == 'breaking'
                    assign bnt_match = true
                    break
                  endif
                endfor
              -%}
              {%- if bnt_match -%}
                {%- if bnt_shown >= bnt_max -%}
                  {%- break -%}
                {%- endif -%}
                {%- liquid
                  assign bnt_fresh = false
                  if article.published_at != blank
                    assign bnt_pub = article.published_at | date: '%s' | plus: 0
                    assign bnt_age = bnt_now | minus: bnt_pub
                    if bnt_age <= bnt_window
                      assign bnt_fresh = true
                    endif
                  endif
                  assign bnt_shown = bnt_shown | plus: 1
                -%}
                <li class="bnt__item">
                  <a class="bnt__link" href="{{ article.url }}">
                    {%- if bnt_fresh -%}
                      <span class="bnt__badge">{{ 'breaking_news.badge' | t }}</span>
                    {%- endif -%}
                    <span class="bnt__title">{{ article.title | escape }}</span>
                  </a>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- elsif request.design_mode -%}
  <p class="bnt-editor" role="status">
    {%- if bnt_on -%}
      {{ 'breaking_news.editor_hidden' | t }}
    {%- else -%}
      {{ 'breaking_news.editor_disabled' | t }}
    {%- endif -%}
  </p>
{%- endif -%}

{% stylesheet %}
  .shopify-section.breaking-news-ticker:not(:has(.bnt)):not(:has(.bnt-editor)) {
    display: none !important;
    margin: 0 !important;
    padding: 0 !important;
    min-height: 0 !important;
    border: 0 !important;
  }

  .bnt {
    --bnt-ink: #14233b;
    --bnt-text: #ffffff;
    --bnt-badge: #9b1c1c;
    background: var(--bnt-ink);
    color: var(--bnt-text);
    font-family: var(--baseFont, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif);
    overflow: hidden;
    max-width: 100%;
  }

  .bnt__viewport {
    container-type: inline-size;
    overflow: hidden;
    padding-block: 4px;
  }

  .bnt__track {
    display: flex;
    width: max-content;
    animation: bnt-marquee 40s linear infinite;
  }

  .bnt__viewport:hover .bnt__track,
  .bnt__viewport:focus-within .bnt__track {
    animation-play-state: paused;
  }

  .bnt--static .bnt__track {
    animation: none;
    width: auto;
  }

  .bnt__list {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 1.25rem;
    min-width: 100cqi;
    flex-shrink: 0;
    margin: 0;
    padding: 0 1.25rem;
    box-sizing: border-box;
  }

  .bnt--static .bnt__list {
    min-width: 0;
    width: 100%;
  }

  .bnt__item {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
  }

  .bnt__item + .bnt__item::before {
    content: "";
    width: 0.28rem;
    height: 0.28rem;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.55);
    flex: none;
  }

  .bnt__link {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 44px;
    color: var(--bnt-text);
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .bnt__link:hover .bnt__title,
  .bnt__link:focus-visible .bnt__title {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .bnt__link:focus-visible {
    outline: 2px solid #ffffff;
    outline-offset: 2px;
    border-radius: 2px;
  }

  .bnt__title {
    white-space: nowrap;
  }

  .bnt__badge {
    flex: none;
    background: var(--bnt-badge);
    color: #ffffff;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    line-height: 1;
    text-transform: uppercase;
    padding: 0.3rem 0.4rem;
    border-radius: 2px;
  }

  .bnt-editor {
    margin: 0;
    padding: 0.65rem 1rem;
    background: #14233b;
    color: #ffffff;
    font-family: var(--baseFont, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif);
    font-size: 0.875rem;
    line-height: 1.4;
  }

  @keyframes bnt-marquee {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bnt__track {
      animation: none;
      width: auto;
    }

    .bnt__list--clone {
      display: none;
    }

    .bnt__viewport {
      overflow-x: auto;
    }

    .bnt__list {
      min-width: 0;
      width: max-content;
    }
  }

  @media (max-width: 749px) {
    .bnt__list {
      padding-inline: 0.9rem;
      gap: 1rem;
    }

    .bnt__item {
      gap: 1rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Breaking News ticker",
  "class": "breaking-news-ticker",
  "limit": 1,
  "enabled_on": {
    "templates": ["index"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Show ticker",
      "default": true
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog",
      "info": "Articles tagged Breaking are eligible. The tag match ignores letter case. If no blog is selected, the News blog is used."
    },
    {
      "type": "range",
      "id": "max_items",
      "label": "Maximum articles",
      "min": 3,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "badge_hours",
      "label": "Breaking window",
      "min": 24,
      "max": 48,
      "step": 1,
      "unit": "h",
      "default": 48,
      "info": "A Breaking article published inside this window shows a Breaking badge. The ticker is omitted entirely unless the newest Breaking article is inside the window. Liquid now can be cached, so the window is approximate."
    }
  ],
  "presets": [
    {
      "name": "Breaking News ticker"
    }
  ]
}
{% endschema %}
